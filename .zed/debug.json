[
  {
    "label": "Debug CLI",
    "build": {
      "command": "sh",
      "args": [
        "-c",
        "cmake -DCMAKE_BUILD_TYPE=Debug -B build --fresh && cmake --build build --clean-first",
      ],
      "cwd": "$ZED_WORKTREE_ROOT",
    },
    "program": "$ZED_WORKTREE_ROOT/build/cli/loany_cli",
    "cwd": "$ZED_WORKTREE_ROOT/build/cli",
    "request": "launch",
    "adapter": "GDB",
  },
]
